# Jupiter API key from https://portal.jup.ag
JUPITER_API_KEY=your-api-key

# Solana wallet private key (base58) for signing swaps
PRIVATE_KEY=your-base58-private-key

# 每笔套利 USDC 数量（三角路径 USDC->corner1->corner2->USDC；默认 1.99）
# TRADE_AMOUNT_USDC=1.99

# 最大滑点 (bps)，默认 3 = 0.03%，三腿总 worst-case < 0.1% 利润阈值
# MAX_SLIPPAGE_BPS=3

# 预检查：最少保留 SOL (lamports) 用于 3 笔交易 gas，默认 0.008 SOL
# MIN_SOL_LAMPORTS=8000000

# Optional: poll interval in ms (default 5000)
POLL_INTERVAL_MS=5000

# PART1: 不执行真实交易，仅检测并打印套利机会（设 1 启用）
DRY_RUN=1

# 网络请求代理（默认 127.0.0.1:7890）；留空则不走代理
PROXY_URL=http://127.0.0.1:7890

# 请求超时毫秒数（默认 30000）
# REQUEST_TIMEOUT_MS=30000

# Solana RPC（PART2 预检查余额用；默认 mainnet 公网）
# RPC_URL=https://api.mainnet-beta.solana.com

# MySQL（套利记录持久化；不配置则跳过写库）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=arbitrage
